# =============================================================================
# MCP Offensive Security Demo — Environment Configuration
# Copy this to .env and fill in your values.
# =============================================================================

# AI Backend: "bedrock" or "ollama"
AI_BACKEND=bedrock

# AWS Bedrock (if AI_BACKEND=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# Ensure AWS credentials are configured (aws configure, IAM role, or env vars)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ollama (if AI_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
# OLLAMA_API_KEY=  # Only needed for cloud-hosted Ollama

# Auth — generate a strong random value, e.g.: openssl rand -hex 32
AUTH_SECRET=your-random-secret-min-32-chars

# Web UI login credentials
MODTESTER_USER=admin
MODTESTER_PASS=your-chosen-password

# Server
MCP_SERVER_URL=http://localhost:8000
MCP_PORT=8000
